Options -MultiViews

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [END]

  RewriteRule ^ index.html [END]
</IfModule>

<IfModule mod_headers.c>
  # Files served at a fixed URL (favicon.svg, icons.svg and other files copied
  # from public/) must revalidate, so a release that changes them shows up.
  <FilesMatch "\.(?:css|js|mjs|png|jpg|jpeg|gif|svg|webp|ico|woff2?)$">
    Header set Cache-Control "public, max-age=0, must-revalidate"
  </FilesMatch>

  # Only Vite's hashed build output (/assets/<name>-<8 char hash>.<ext>) gets a
  # new URL whenever its content changes, so only it is cached as immutable.
  # <FilesMatch> sees only the base name, so match the request path instead:
  # a fixed-URL public/ file such as /logo-12345678.svg must still revalidate.
  # (<LocationMatch> is not allowed in .htaccess.)
  <IfModule mod_setenvif.c>
    SetEnvIf Request_URI "^/assets/[^/]+-[A-Za-z0-9_-]{8}\.(?:css|js|mjs|png|jpg|jpeg|gif|svg|webp|ico|woff2?)$" LATTE_HASHED_ASSET
    <FilesMatch "\.(?:css|js|mjs|png|jpg|jpeg|gif|svg|webp|ico|woff2?)$">
      Header set Cache-Control "public, max-age=31536000, immutable" env=LATTE_HASHED_ASSET
    </FilesMatch>
  </IfModule>

  <FilesMatch "^index\.html$|^latte-config\.json$">
    Header set Cache-Control "no-store, no-cache, must-revalidate, max-age=0"
  </FilesMatch>
</IfModule>
